function addAnswer(obj, text) {
    let parentDiv = obj.parentElement;      // 클릭된 버튼(obj)의 부모 요소(div)를 찾음
    let newP = document.createElement("p"); // 새로운 <p> 태그 생성
    newP.innerHTML = text;                  // 전달받은 텍스트(정답)를 <p> 태그에 삽입
    parentDiv.appendChild(newP);            // 부모 <div>의 마지막 자식으로 <p> 태그 추가
}
